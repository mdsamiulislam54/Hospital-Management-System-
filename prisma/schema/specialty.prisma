model Specialty {
  id                String            @id @default(uuid())  @db.Uuid
  title             String            @unique
  icon              String?
  description       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  doctorSpecialties DoctorSpecialty[]

  @@index([title], name: "idx_specialty_title")
  @@map("specialty")
}
