model Appointment {
    id               String            @id @default(uuid()) @db.Uuid
    patientId        String            @db.Uuid
    doctorId         String            @db.Uuid
    doctorScheduleId String            @unique @db.Uuid
    videoCallingId   String
    status           AppointmentStatus @default(SCHEDULED)
    isDelete         Boolean
    deletedAt        DateTime
    paymentStatus    PaymentStatus     @default(UNPAID)
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt

    doctorschedule DoctorSchedule @relation(fields: [doctorScheduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    payment      Payment?
    review       Review?
    prescription Prescription?

    @@index([doctorId])
    @@index([doctorScheduleId])
    @@index([videoCallingId])
    @@index([patientId])
    @@map("appointment")
}
