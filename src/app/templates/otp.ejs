<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <title>Email Verification</title>
    <style>
        body{
            font-family: Arial, sans-serif;
            background-color:#f4f4f4;
            margin:0;
            padding:0;
        }
        .container{
            max-width:600px;
            margin:40px auto;
            background:#ffffff;
            padding:30px;
            border-radius:8px;
            box-shadow:0 0 10px rgba(0,0,0,0.1);
        }
        .header{
            text-align:center;
            margin-bottom:20px;
        }
        .otp{
            font-size:32px;
            font-weight:bold;
            letter-spacing:5px;
            text-align:center;
            color:#2c3e50;
            margin:20px 0;
        }
        .footer{
            margin-top:30px;
            font-size:12px;
            color:#888;
            text-align:center;
        }
    </style>
</head>
<body>

<div class="container">
    
    <div class="header">
        <h2>Email Verification</h2>
    </div>

    <p>Hello <strong><%= name %></strong>,</p>

    <p>Your One Time Password (OTP) for verification is:</p>

    <div class="otp">
        <%= otp %>
    </div>

    <p>This OTP will expire in <strong>5 minutes</strong>.</p>

    <p>If you did not request this code, please ignore this email.</p>

    <p>Thank you,<br/>Support Team</p>

    <div class="footer">
        © <%= new Date().getFullYear() %> Your Company. All rights reserved.
    </div>

</div>

</body>
</html>